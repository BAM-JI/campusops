graph TD
    subgraph UI["Capa de Interfaz (UI)"]
        LoginScreen["LoginScreen"]
        IncidentScreen["IncidentListAndDetailScreen"]
    end

    subgraph Composition["Raíz de composición"]
        App["App.tsx"]
    end

    subgraph Application["Capa de Aplicación"]
        GetIncidentsUseCase["GetIncidentsUseCase"]
        GetIncidentDetailUseCase["GetIncidentDetailUseCase"]
        CreateIncidentUseCase["CreateIncidentUseCase"]
        PerformIncidentActionUseCase["PerformIncidentActionUseCase"]
    end

    subgraph Domain["Capa de Dominio"]
        Incident["Entidad: Incident"]
        IIncidentRepository["Puerto: IIncidentRepository"]
        ApiResult["ApiResult / ApiError"]
        LocationBoundary["Límite: LocationProvider"]
    end

    subgraph Infrastructure["Capa de Infraestructura"]
        IncidentClient["IncidentClient (HTTP, timeout, DTO)"]
        SessionManager["SessionManager (login, refresh compartido, logout)"]
        SecureStore["expo-secure-store"]
        InMemoryIncidentRepo["InMemoryIncidentRepository (doble de prueba)"]
    end

    App --> LoginScreen
    App --> IncidentScreen
    App --> SessionManager
    App --> IncidentClient
    IncidentScreen --> GetIncidentsUseCase
    IncidentScreen --> GetIncidentDetailUseCase
    IncidentScreen --> CreateIncidentUseCase
    GetIncidentsUseCase --> IIncidentRepository
    GetIncidentDetailUseCase --> IIncidentRepository
    CreateIncidentUseCase --> IIncidentRepository
    PerformIncidentActionUseCase --> IIncidentRepository
    IIncidentRepository --> Incident
    IIncidentRepository --> ApiResult
    IncidentClient -.->|implementa| IIncidentRepository
    InMemoryIncidentRepo -.->|implementa| IIncidentRepository
    IncidentClient --> SessionManager
    SessionManager --> SecureStore
